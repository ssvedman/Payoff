#!/bin/sh
# Block a push that would publish household PII.
#
# This exists because a promise to "scan before pushing" was made and then not
# kept: the scan ran after the push, when it could no longer prevent anything.
# A hook cannot forget the order.
#
# Patterns live in .githooks/pii-patterns, which is gitignored along with
# everything else that names the household.
#
# Scope is LOCAL refs (--branches --tags), never --all. --all takes in
# refs/remotes too, so the moment a leak reached the remote the hook would keep
# flagging the remote's copy and refuse the force-push that removes it — the
# remediation deadlocking on the very thing it was there to remediate.

PATTERNS_FILE="$(git rev-parse --show-toplevel)/.githooks/pii-patterns"
[ -f "$PATTERNS_FILE" ] || exit 0

FAIL=0
while IFS= read -r pat; do
  [ -z "$pat" ] && continue
  case "$pat" in \#*) continue ;; esac
  for c in $(git rev-list --branches --tags); do
    # Exempt ONLY the untracked pattern file, and only in case it ever becomes
    # tracked. The previous filters skipped all of .githooks/ and .gitignore —
    # both of which ARE committed and public, so the exemptions could never
    # suppress the file they were written for and only ever hid real hits.
    hits=$(git grep -l -i -F "$pat" "$c" -- 2>/dev/null | sed "s|^$c:||" | grep -v '^\.githooks/pii-patterns$')
    if [ -n "$hits" ]; then
      echo "pre-push: BLOCKED — '$pat' found in commit $(git rev-parse --short "$c"):"
      echo "$hits" | sed 's/^/    /'
      FAIL=1
    fi
  done
done < "$PATTERNS_FILE"

# A commit MESSAGE is not part of any tree either, so the grep above cannot see
# it. A message is published exactly as widely as the files are, and explaining a
# categorization fix is precisely the kind of commit that wants to quote a real
# account name to justify itself. Check messages against the same patterns.
while IFS= read -r pat; do
  [ -z "$pat" ] && continue
  case "$pat" in \#*) continue ;; esac
  for c in $(git rev-list --branches --tags); do
    if git log -1 --format='%B' "$c" | grep -qiF "$pat"; then
      echo "pre-push: BLOCKED — '$pat' appears in the MESSAGE of commit $(git rev-parse --short "$c")."
      echo "pre-push: Rewrite the message; the files being clean is not enough."
      FAIL=1
    fi
  done
done < "$PATTERNS_FILE"

# Commit IDENTITY is not part of any tree, so the grep above cannot see it. The
# PII audit found a real personal email published as the author of every commit,
# which no file edit would have fixed. Check it explicitly.
for c in $(git rev-list --branches --tags); do
  for who in "%ae" "%ce"; do
    addr=$(git log -1 --format="$who" "$c")
    case "$addr" in
      *@users.noreply.github.com) ;;
      *noreply*) ;;
      "")          ;;
      *)
        echo "pre-push: BLOCKED — commit $(git rev-parse --short "$c") is authored by <$addr>."
        echo "pre-push: Personal addresses are published with every commit and are"
        echo "pre-push: visible through the GitHub API. Use the noreply address:"
        echo "pre-push:   git config user.email '<id>+<user>@users.noreply.github.com'"
        echo "pre-push: then re-author the history — amending the tip is not enough."
        FAIL=1
        ;;
    esac
  done
done

if [ "$FAIL" = "1" ]; then
  echo ""
  echo "pre-push: nothing was pushed. Remove the PII and rewrite the offending"
  echo "pre-push: commits — amending the tip is not enough if history still has it."
  exit 1
fi
exit 0
